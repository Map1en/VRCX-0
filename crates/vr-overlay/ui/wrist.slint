export struct WristDeviceItem {
    label: string,
    percent: string,
    label-color: color,
    percent-color: color,
    battery-color: color,
    battery-fill: float,
    show-percent: bool,
    show-battery: bool,
}

export struct WristFeedItem {
    time: string,
    actor: string,
    detail: string,
    actor-color: color,
    detail-color: color,
    severity-color: color,
    has-actor: bool,
    show-severity: bool,
}

export component WristPanel inherits Window {
    width: 512px;
    height: 512px;
    background: transparent;

    in property <bool> dark-background: true;
    in property <color> accent-color: #5eead4;
    in property <[WristDeviceItem]> devices: [];
    in property <[WristFeedItem]> feed-lines: [];
    in property <string> footer-left;
    in property <string> footer-center;
    in property <string> footer-right;

    property <color> background-color: root.dark-background ? #101010eb : #10101096;
    property <color> panel-color: root.dark-background ? #161616cd : #16161678;
    property <color> divider-color: #78787855;
    property <color> row-divider-color: #7878782d;
    property <color> text-color: #eeeeee;
    property <color> muted-color: #a8a8a8;

    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: root.background-color;
    }

    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 38px;
        background: root.panel-color;
    }

    Rectangle {
        x: 0px;
        y: parent.height - 30px;
        width: parent.width;
        height: 30px;
        background: root.panel-color;
    }

    Rectangle {
        x: 0px;
        y: 38px;
        width: parent.width;
        height: 1px;
        background: root.divider-color;
    }

    Rectangle {
        x: 0px;
        y: parent.height - 30px;
        width: parent.width;
        height: 1px;
        background: root.divider-color;
    }

    for device[index] in root.devices : Rectangle {
        x: 18px + index * 90px;
        y: 8px;
        width: 90px;
        height: 24px;
        visible: self.x + self.width <= root.width - 18px;

        Text {
            x: 0px;
            y: 2px;
            width: 30px;
            height: 18px;
            text: device.label;
            font-size: 14px;
            color: device.label-color;
        }

        Text {
            x: 34px;
            y: 3px;
            width: 28px;
            height: 17px;
            text: device.percent;
            font-size: 13px;
            visible: device.show-percent;
            color: device.percent-color;
        }

        Rectangle {
            x: device.show-percent ? 64px : 34px;
            y: 6px;
            width: 20px;
            height: 11px;
            visible: device.show-battery;
            border-color: device.battery-color;
            border-width: 1.5px;
            background: transparent;

            Rectangle {
                x: 2.5px;
                y: 2.5px;
                width: 15px * device.battery-fill;
                height: 6px;
                background: device.battery-color;
            }
        }

        Rectangle {
            x: device.show-percent ? 85px : 55px;
            y: 9.5px;
            width: 3px;
            height: 4px;
            visible: device.show-battery;
            background: device.battery-color;
        }
    }

    for line[index] in root.feed-lines : Rectangle {
        x: 18px;
        y: 44px + index * 34px;
        width: parent.width - 36px;
        height: 34px;
        visible: self.y + self.height < root.height - 30px;

        Rectangle {
            x: 0px;
            y: 4px;
            width: 3px;
            height: 23px;
            visible: line.show-severity;
            background: line.severity-color;
        }

        Text {
            x: 7px;
            y: 2px;
            width: 45px;
            height: 18px;
            text: line.time;
            font-size: 14px;
            color: root.muted-color;
        }

        Text {
            x: 58px;
            y: 1px;
            width: 178px;
            height: 22px;
            text: line.actor;
            font-size: 17px;
            visible: line.has-actor;
            color: line.actor-color;
        }

        Text {
            x: line.has-actor ? 244px : 58px;
            y: 1px;
            width: line.has-actor ? parent.width - 244px : parent.width - 58px;
            height: 22px;
            text: line.detail;
            font-size: 17px;
            color: line.detail-color;
        }

        Rectangle {
            x: 0px;
            y: 31px;
            width: parent.width;
            height: 1px;
            background: root.row-divider-color;
        }
    }

    Text {
        x: 18px;
        y: parent.height - 22px;
        width: 128px;
        height: 17px;
        text: root.footer-left;
        font-size: 13px;
        color: root.muted-color;
    }

    Text {
        x: parent.width / 2 - 90px;
        y: parent.height - 22px;
        width: 180px;
        height: 17px;
        text: root.footer-center;
        font-size: 13px;
        horizontal-alignment: center;
        color: root.muted-color;
    }

    Text {
        x: parent.width - 98px;
        y: parent.height - 22px;
        width: 80px;
        height: 17px;
        text: root.footer-right;
        font-size: 13px;
        horizontal-alignment: right;
        color: root.muted-color;
    }
}
