import { AvatarPlaceholder } from "avatar_placeholder.slint";

export struct HmdToastItem {
    actor: string,
    action: string,
    avatar: image,
    has-avatar: bool,
    show-avatar: bool,
    relation-color: color,
    severity-color: color,
}

export component HmdToastPanel inherits Window {
    width: 960px;
    height: 528px;
    background: transparent;

    in property <bool> dark-background: true;
    in property <[HmdToastItem]> toasts: [];

    property <color> card-color: root.dark-background ? #11161dee : #11161dc7;
    property <color> card-border-color: #ffffff24;
    property <color> avatar-surface-color: #ffffff0d;
    property <color> action-color: #d7dce3;

    for toast[index] in root.toasts : Rectangle {
        x: (root.width - 860px) / 2;
        y: root.height - 20px - 112px - index * 124px;
        width: 860px;
        height: 112px;
        visible: self.y >= 0px;
        background: root.card-color;
        border-color: root.card-border-color;
        border-width: 1px;
        border-radius: 14px;
        clip: true;
        property <length> content-x: toast.show-avatar ? 118px : 24px;
        property <length> content-width: self.width - self.content-x - 24px;

        Rectangle {
            x: 0px;
            y: 12px;
            width: 5px;
            height: parent.height - 24px;
            border-radius: 3px;
            background: toast.severity-color;
        }

        Rectangle {
            x: 20px;
            y: 17px;
            width: 78px;
            height: 78px;
            border-radius: 39px;
            border-color: toast.relation-color;
            border-width: 2px;
            background: root.avatar-surface-color;
            visible: toast.show-avatar;
        }

        AvatarPlaceholder {
            x: 24px;
            y: 21px;
            diameter: 70px;
            visible: toast.show-avatar && !toast.has-avatar;
        }

        Image {
            x: 24px;
            y: 21px;
            width: 70px;
            height: 70px;
            source: toast.avatar;
            visible: toast.show-avatar && toast.has-avatar;
        }

        Text {
            x: parent.content-x;
            y: 17px;
            width: parent.content-width;
            height: 34px;
            text: toast.actor;
            font-size: 28px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
            color: toast.relation-color;
        }

        Text {
            x: parent.content-x;
            y: 59px;
            width: parent.content-width;
            height: 27px;
            text: toast.action;
            font-size: 20px;
            vertical-alignment: center;
            overflow: elide;
            color: root.action-color;
        }
    }
}
