{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "ignorePatterns": ["**/*.rs", "**/*.toml", "**/*.lock", "signatures/"],
    "printWidth": 80,
    "tabWidth": 4,
    "singleQuote": true,
    "trailingComma": "none",
    "sortImports": {
        "internalPattern": ["@/"],
        "sortSideEffects": false
    },
    "sortTailwindcss": {
        "functions": ["cn", "clsx", "cva"]
    }
}
