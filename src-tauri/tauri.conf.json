{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "VRCX-0",
  "version": "0.1.0",
  "identifier": "com.vrcx-0.app",
  "build": {
    "frontendDist": "../build/html",
    "devUrl": "http://localhost:9000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run prod"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "VRCX-0",
        "width": 1024,
        "height": 768,
        "minWidth": 320,
        "minHeight": 240,
        "center": true,
        "decorations": true,
        "resizable": true
      }
    ],
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/icon.png",
      "tooltip": "VRCX-0"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "compression": "lzma",
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}
